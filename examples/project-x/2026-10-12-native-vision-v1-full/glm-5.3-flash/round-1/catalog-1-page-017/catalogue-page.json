  "figures": [
    {
      "title": "Габаритный чертёж ОПН 10 кВ (1,1 Кл), варианты III СЗ и IV СЗ",
      "description": "Two outline/section drawings side by side labelled III СЗ (left) and IV СЗ (right). Dimension М10 measures the terminal stud width at the top and the bottom terminal width at the bottom; in the III СЗ view an additional М10 dimension appears between the bottom terminal and the lower shed edge. Ø98 measures the housing core diameter at mid-body in both views. 191±1 (printed vertically) measures overall height between the top and bottom extent arrows. Dimension 10 (vertical) appears near the top terminal and near the bottom shed/terminal edge in both views. The III СЗ drawing shows a body with 3 sheds; the IV СЗ drawing shows a body with 5 sheds. Exact endpoint attachment of leader lines is partly ambiguous at print resolution.",
      "labels": [
        "III СЗ",
        "IV СЗ",
        "M10",
        "Ø98",
        "191±1",
        "10"
      ]
    },
    {
      "title": "Габаритный чертёж ОПН 10 кВ (1,2 Кл), варианты III СЗ и IV СЗ",
      "description": "Same pair of drawings for the 1,2 Кл group: III СЗ (3-shed body) and IV СЗ (5-shed body). М10 dimensions the top and bottom terminal stud width (bottom М10 also spans terminal-to-shed edge in III СЗ); Ø98 measures the mid-body housing diameter; 191±1 (vertical) measures the overall height between extent arrows; 10 (vertical) measures shed/terminal step heights near the top and bottom.",
      "labels": [
        "III СЗ",
        "IV СЗ",
        "M10",
        "Ø98",
        "191±1",
        "10"
      ]
