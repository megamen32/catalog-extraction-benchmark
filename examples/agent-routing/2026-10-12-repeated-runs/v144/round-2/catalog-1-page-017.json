{
  "title": "ОПН 10 кВ с зарядом пропускной способности 1,1 Кл и 1,2 Кл",
  "printed_page": "17",
  "text_blocks": [
    {
      "kind": "heading",
      "text": "ОПН 10 кВ с зарядом пропускной способности 1,1 Кл"
    },
    {
      "kind": "paragraph",
      "text": "Изготавливаются по ТУ 27.12.10–041–21639232-2020."
    },
    {
      "kind": "paragraph",
      "text": "Номинальный разрядный ток — 10 кА."
    },
    {
      "kind": "paragraph",
      "text": "Ток взрывобезопасности:"
    },
    {
      "kind": "paragraph",
      "text": "• длительностью не менее 1 секунды — не менее 0,6 кА;"
    },
    {
      "kind": "paragraph",
      "text": "• длительностью не менее 0,2 секунд — не менее 65 кА."
    },
    {
      "kind": "paragraph",
      "text": "Соответствуют требованиям ГОСТ Р 52725-2021."
    },
    {
      "kind": "heading",
      "text": "ОПН 10 кВ с зарядом пропускной способности 1,2 Кл"
    },
    {
      "kind": "paragraph",
      "text": "Изготавливаются по ТУ 27.12.10–041–21639232-2020."
    },
    {
      "kind": "paragraph",
      "text": "Номинальный разрядный ток — 10 кА."
    },
    {
      "kind": "paragraph",
      "text": "Ток взрывобезопасности:"
    },
    {
      "kind": "paragraph",
      "text": "• длительностью не менее 1 секунды — не менее 0,6 кА."
    },
    {
      "kind": "paragraph",
      "text": "• длительностью не менее 0,2 секунд — не менее 65 кА."
    },
    {
      "kind": "paragraph",
      "text": "Соответствуют требованиям ГОСТ Р 52725-2021."
    },
    {
      "kind": "footer",
      "text": "АО «Энергия+21», 457000 Челябинская область, г. Увельский ул. Сафонова, д. 10, +7 (351) 211-60-10, www.energy-21.ru"
    }
