  "figures": [
    {
      "title": "ЛК 70/110-Иу-2 ГС",
      "description": "Чертёж линейного подвесного полимерного изолятора: главный фронтальный вид с двумя металлическими оконцевателями (верхний — «гнездо» с проушиной, нижний — «гнездо» с проушиной), пять парных болтов на верхнем и нижнем фланцах, пять юбочных ребер на стержне. Справа внизу — вынесенный узел (в разрезе) толщины оболочки. Размерные линии: ширина верхнего проушины 19.2 +1.6/0; высота 20.5; диаметр Ø90 (верхний фланец); диаметр Ø165 (нижний фланец); отверстие Ø17 +1.3/0; толщина 16 +0.9/-1.1; габаритные H±5 и L±2.",
      "labels": [
        "19.2 +1.6/0",
        "20.5",
        "Ø90",
        "Ø165",
        "H±5",
        "L±2",
        "Ø17 +1.3/0",
        "16 +0.9/-1.1"
      ]
    },
    {
      "title": "ЛК 120/110-Иу-4 ГП",
      "description": "Чертёж линейного подвесного полимерного изолятора с верхним оконцевателем «гнездо-проушина» и нижним цилиндрическим оконцевателем: главный фронтальный вид, четыре парных болта на верхнем фланце и четыре на нижнем, шесть юбочных ребер, вынесенный разрез узла справа. Размерные линии: 19.2 +1.6/0 (ширина верхнего проушины); 20.5; O90; O65; Ø165; H±5; L±2; Ø17 0/-1.2; Ø33.3 0/-1.5.",
      "labels": [
        "19.2 +1.6/0",
        "20.5",
        "O90",
        "O65",
        "Ø165",
        "H±5",
        "L±2",
        "Ø17 0/-1.2",
        "Ø33.3 0/-1.5"
      ]
    },
    {
      "title": "ЛК 160/110-ИУ-4 СС",
      "description": "Чертёж линейного подвесного полимерного изолятора с верхним и нижним оконцевателями типа «проушина-проушина» с цилиндрическим отверстием: главный фронтальный вид, по четыре парных болта на верхнем и нижнем фланцах, семь юбочных ребер, два вынесенных разреза справа (толщина верхней и нижней проушины). Размерные линии: Ø26 +1.5/0 (верхнее отверстие); Ø26 +1.5/0 (нижнее отверстие, подписано латинской O); 25 +0.9/-1.3 (дважды, верхний и нижний узлы); Ø165 (дважды); Ø120; Ø80; H±5; L±2; 1205.",
      "labels": [
        "Ø26 +1.5/0",
        "O26 +1.5/0",
        "25 +0.9/-1.3",
        "Ø165",
        "Ø120",
        "Ø80",
        "H±5",
        "L±2",
        "1205"
      ]
    }
