  "text_blocks": [
    {
      "kind": "paragraph",
      "text": "ОГРАНИЧИТЕЛИ ПЕРЕНАПРЯЖЕНИЯ НЕЛИНЕЙНЫЕ"
    },
    {
      "kind": "paragraph",
      "text": "184 АО «Энергия+21» Тел./ факс: +7 (351) 211-60-20, e-mail: sales@energy-21.ru www.energy-21.ru"
    },
    {
      "kind": "paragraph",
      "text": "ОПН 6 кВ с зарядами пропускной способности 1,1 Кл"
    },
    {
      "kind": "paragraph",
      "text": "Изготавливаются по ТУ 27.12.10–041–21639232-2020."
    },
    {
      "kind": "paragraph",
      "text": "Номинальный разрядный ток — 10 кА."
    },
    {
      "kind": "paragraph",
      "text": "Ток взрывобезопасности:"
    },
    {
      "kind": "paragraph",
      "text": "длительностью не менее 1 секунды  не менее 0,6 кА;"
    },
    {
      "kind": "paragraph",
      "text": "длительностью не менее 0,2 секунд  не менее 65 кА."
    },
    {
      "kind": "paragraph",
      "text": "Соответствуют требованиям ГОСТ Р 52725-2021."
    },
    {
      "kind": "paragraph",
      "text": "ОПН 6 кВ с зарядом пропускной способности 1,2 Кл"
